# Environment — never commit secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# User-generated uploads (stored in Supabase, not in repo)
uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Source maps
*.js.map
*.tsbuildinfo

# Firebase service account (if accidentally saved locally)
*-firebase-adminsdk-*.json
firebase-service-account*.json

# Test coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

