PORT=5000
NODE_ENV=development
LOG_LEVEL=debug
API_RATE_LIMIT_MAX=300
LOG_HTTP_REQUESTS=false
LOGIN_RATE_LIMIT_WINDOW_MINUTES=10
LOGIN_RATE_LIMIT_MAX=8
REFRESH_RATE_LIMIT_WINDOW_MINUTES=10
REFRESH_RATE_LIMIT_MAX=30

# Frontend origins allowed by CORS/WebSocket (comma-separated)
FRONTEND_URLS=http://localhost:5173

# Optional regex matcher for preview deploy URLs (GitHub Actions PR previews, etc.)
FRONTEND_ORIGIN_REGEX=

# Preferred for Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DB_POOL_MAX=20
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional fallback fields if DATABASE_URL is not set
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=name_of_your_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false

JWT_ACCESS_SECRET=your_random_access_secret
JWT_REFRESH_SECRET=your_random_refresh_secret

MAX_FILE_SIZE=5242880

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_PARTY_BUCKET=your_party_bucket_name
SUPABASE_VERIFY_REDIRECT_PATH=/auth/verify-email
SUPABASE_RESET_REDIRECT_PATH=/auth/reset-password

# App version control — update these to force mobile users to upgrade
# min_version: users below this version are blocked until they update
# latest_version: informational, shown on the update screen
# download_url: where users go to download the new APK
APP_MIN_VERSION=1.0
APP_LATEST_VERSION=1.0
APP_DOWNLOAD_URL=https://your-website.com/download

# ────────────────────────────────────────────────────────────────────────────
# RAZORPAY PAYMENT GATEWAY
# Get keys from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for test mode, rzp_live_* for production.
# ────────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Webhook secret from Razorpay Dashboard → Webhooks → your endpoint → Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
